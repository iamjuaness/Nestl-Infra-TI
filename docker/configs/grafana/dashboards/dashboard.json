{
  "dashboard": {
    "id": null,
    "uid": "nestle-infra-ti",
    "title": "🏭 Nestlé - Infraestructura TI",
    "tags": ["nestle", "docker", "prometheus"],
    "timezone": "America/Bogota",
    "schemaVersion": 38,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Estado de Servicios",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job=~\"nginx|mysql|node-exporter|prometheus\"}",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "🔴 CAÍDO", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "🟢 ACTIVO", "color": "green"}}, "type": "value"}
            ],
            "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}
          }
        }
      },
      {
        "id": 2,
        "title": "CPU Usage (%)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU {{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]}
          }
        }
      },
      {
        "id": 3,
        "title": "Memoria Usage (%)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Memoria {{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}
          }
        }
      },
      {
        "id": 4,
        "title": "Disco Root Usage (%)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
            "legendFormat": "Disco /"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}
          }
        }
      },
      {
        "id": 5,
        "title": "Conexiones Nginx Activas",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {"expr": "nginx_connections_active", "legendFormat": "Activas"},
          {"expr": "nginx_connections_reading", "legendFormat": "Leyendo"},
          {"expr": "nginx_connections_writing", "legendFormat": "Escribiendo"},
          {"expr": "nginx_connections_waiting", "legendFormat": "Esperando"}
        ],
        "fieldConfig": {"defaults": {"unit": "short"}}
      },
      {
        "id": 6,
        "title": "Requests HTTP Totales (Nginx)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "rate(nginx_http_requests_total[5m])",
            "legendFormat": "req/s"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "reqps"}}
      },
      {
        "id": 7,
        "title": "MySQL - Queries por segundo",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(mysql_global_status_queries[5m])",
            "legendFormat": "Queries/s"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "reqps"}}
      },
      {
        "id": 8,
        "title": "MySQL - Conexiones Activas",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "mysql_global_status_threads_connected",
            "legendFormat": "Conexiones"
          },
          {
            "expr": "mysql_global_status_threads_running",
            "legendFormat": "Ejecutando"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "short"}}
      },
      {
        "id": 9,
        "title": "MySQL - Estado de Replicación",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "mysql_slave_status_slave_io_running",
            "legendFormat": "IO Thread"
          },
          {
            "expr": "mysql_slave_status_slave_sql_running",
            "legendFormat": "SQL Thread"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "❌ Detenido", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "✅ Corriendo", "color": "green"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 10,
        "title": "Red - Tráfico (MB/s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total[5m]) / 1024 / 1024",
            "legendFormat": "RX {{device}}"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total[5m]) / 1024 / 1024",
            "legendFormat": "TX {{device}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "MBs"}}
      },
      {
        "id": 11,
        "title": "Contenedores Docker Activos",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "count(container_last_seen)",
            "legendFormat": "Contenedores"
          }
        ]
      },
      {
        "id": 12,
        "title": "Uptime Servidor",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 32},
        "targets": [
          {
            "expr": "node_time_seconds - node_boot_time_seconds",
            "legendFormat": "Uptime"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "dtdurations"}}
      }
    ]
  }
}